# ============================================================
# SmartResearch-AI — .gitignore
# ============================================================

# ── Credentials & Secrets ───────────────────────────────────
.env
*.env
!.env.example

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python
venv/
env/
ENV/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
htmlcov/
.coverage
*.egg-info/
dist/
build/
*.egg
.mypy_cache/
.ruff_cache/

# ── Database & local files ───────────────────────────────────
*.db
*.sqlite3
financial_reports.db

# ── Generated reports & uploads ─────────────────────────────
app/generated_reports/*
!app/generated_reports/.gitkeep
app/uploads/*
!app/uploads/.gitkeep
app/charts/*
!app/charts/.gitkeep

# ── Node / Frontend ─────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/.next/
frontend/.next
.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# ── IDE & OS ─────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── Docker volumes ───────────────────────────────────────────
postgres_data/

# ── Misc ─────────────────────────────────────────────────────
*.bak
*.tmp
